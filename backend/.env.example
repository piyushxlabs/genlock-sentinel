# ==============================================================================
# GENLOCK SENTINEL - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Strictly compliant with AGENT_MASTER_PLAN.md Section 2

# Google Cloud / Gemini Enterprise Agent Platform
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
GOOGLE_CLOUD_PROJECT=genlock-sentinel-dev
GEMINI_REASONING_MODEL=gemini-3.1-pro
GEMINI_FAST_MODEL=gemini-3.7-flash

# Grafana MCP Integration (Prometheus & Loki)
GRAFANA_URL=https://genlock-sentinel.grafana.net
GRAFANA_SERVICE_ACCOUNT_TOKEN=glsa_example_token_placeholder
GRAFANA_LOKI_DATASOURCE_UID=grafanacloud-logs

# Tempo MCP Integration (Distributed Tracing)
TEMPO_MCP_URL=https://genlock-sentinel.grafana.net/tempo/api/mcp
GRAFANA_TEMPO_DATASOURCE_UID=grafanacloud-traces

# Database & Checkpoint Backend (Local zero-config SQLite default; Cloud SQL PostgreSQL in Prod)
ADK_SESSION_DB_URL=sqlite+aiosqlite:///./sentinel_sessions.db
# CLOUD_SQL_POSTGRES_URL=postgresql+asyncpg://sentinel_admin:password@localhost:5432/genlock_sentinel

# Google Cloud Secret Manager (Secrets resolved at call-time; never stored in state)
SECRET_MANAGER_PROJECT_ID=genlock-sentinel-dev

# Langfuse / OpenTelemetry GenAI Conventions
LANGFUSE_PUBLIC_KEY=pk-lf-placeholder
LANGFUSE_SECRET_KEY=sk-lf-placeholder
OTEL_EXPORTER_OTLP_ENDPOINT=https://cloud.langfuse.com/api/public/otel

# nDisplay Cluster Manager Control-Plane API
CLUSTER_MANAGER_API_URL=https://cluster-manager.stage.local/api/v1
CLUSTER_MANAGER_API_KEY=cluster_api_key_placeholder

# Architectural & Autonomous Operational Guardrails
CONFIDENCE_FLOOR=0.75
FINANCIAL_THRESHOLD_USD=5000
QUERY_WINDOW_MAX_SECONDS=120
